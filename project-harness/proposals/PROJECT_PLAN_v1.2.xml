  <business_logic_v1_2>

    <rulebook>
      <rule id="BL-01">All graph writes are transactionally atomic.</rule>
      <rule id="BL-02">No route issues direct Cypher; routes delegate to services and writers.</rule>
      <rule id="BL-03">All Cypher uses parameters; no string interpolation.</rule>
      <rule id="BL-04">Runtime/gameplay relation updates use delta endpoint only.</rule>
      <rule id="BL-05">Absolute relation writes are admin-route-only and audited.</rule>
      <rule id="BL-06">Hard deletes must cascade in one transaction and return impact metadata.</rule>
      <rule id="BL-07">Embedding invalidation runs after successful commit for affected IDs.</rule>
      <rule id="BL-08">Every mutation includes metadata: request_id, actor_id, reason.</rule>
    </rulebook>

    <flows>

      <flow name="Node Upsert" endpoint="POST /v1/graph/{resource}">
        <step order="1">Validate request model and resource type.</step>
        <step order="2">Enforce mutable/immutable field policy.</step>
        <step order="3">Open transaction in graph_edit_service.</step>
        <step order="4">Call type-specific writer (character/event/location).</step>
        <step order="5">Commit transaction.</step>
        <step order="6">Invalidate embedding index for affected nodes.</step>
        <step order="7">Return envelope with persisted projection.</step>
      </flow>

      <flow name="Edge Create or Update" endpoint="POST /v1/graph/edges/*">
        <step order="1">Validate source/target existence and edge schema.</step>
        <step order="2">Open transaction and execute writer with parameterized Cypher.</step>
        <step order="3">Commit and return edge summary.</step>
        <step order="4">Invalidate affected nodes for retrieval freshness.</step>
      </flow>

      <flow name="Relation Delta Mutation" endpoint="POST /v1/graph/relations/delta">
        <step order="1">Validate deltas and metadata.</step>
        <step order="2">Read current relation and current delta_log.</step>
        <step order="3">Validate per-turn and per-window bounds.</step>
        <step order="4">Clamp final values to [0,100].</step>
        <step order="5">Write relation values and append delta_log in same transaction.</step>
        <step order="6">Commit and return updated relation values.</step>
      </flow>

      <flow name="Relation Absolute Admin Mutation" endpoint="PUT /v1/graph/admin/relations/absolute">
        <step order="1">Enforce admin scope and route-level governance.</step>
        <step order="2">Validate absolute bounds and reason.</step>
        <step order="3">Open transaction and write absolute values.</step>
        <step order="4">Apply delta log policy (append adjustment event or reset by config).</step>
        <step order="5">Commit and emit audit entry.</step>
      </flow>

      <flow name="Hard Delete Cascade" endpoint="DELETE /v1/graph/admin/(characters|events|locations)/{id}">
        <step order="1">Enforce admin scope.</step>
        <step order="2">Resolve dependency graph and validate policy.</step>
        <step order="3">Open transaction.</step>
        <step order="4">Delete connected edges in deterministic order.</step>
        <step order="5">Delete target node.</step>
        <step order="6">Record impact counts and audit metadata.</step>
        <step order="7">Commit or rollback entirely on any error.</step>
        <step order="8">Invalidate embeddings for affected IDs.</step>
      </flow>

      <flow name="Admin Reindex" endpoint="POST /v1/graph/admin/reindex">
        <step order="1">Enforce admin scope and validate request metadata.</step>
        <step order="2">Resolve target ids (explicit list or full set).</step>
        <step order="3">Invoke embedding_index invalidate plus reindex for each target.</step>
        <step order="4">Collect failures and return deterministic operation summary.</step>
      </flow>

    </flows>
  </business_logic_v1_2>

