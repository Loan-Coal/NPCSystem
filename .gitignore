htmlcov/

# E2E and eval outputs
e2e/transcripts/
evals/reports/
# Generation artifacts ARE tracked (DEC-158, 2026-08-09): meta.json + outputs.jsonl +
# judged.jsonl are what make a published number reproducible and auditable. Keeping
# them out meant every quoted rate rested on files that existed on one machine only.
# Calibration labels ARE tracked (DEC-158, reverses the earlier privacy stance): two
# rounds of hand-labelling were one `git clean -xdf` from unrecoverable. Only the
# synthetic mock artifacts stay out — they are random by construction and a kappa
# computed from them is meaningless, so they must never be mistaken for a real pass.
evals/calibration/mock_*.jsonl
# Oracle labeller artifacts (EVAL-P15.1) — same reasoning as the mock ones, for a
# different reason: they are not random but they ARE fully regenerable from the
# committed transcript plus the declared rule, so committing them would add noise
# the loop's whole-tree staging (ISSUE-139) would then sweep into unrelated commits.
# `make mock-calibrate-oracle GEN_ID=<id>` rebuilds all of them byte-identically.
evals/calibration/oracle/
evals/calibration/oracle_batches/
# Timestamped safety copies written before any rewrite of a file holding human
# verdicts. Local recovery aid; the tracked labels file is the artifact.
evals/calibration/*.bak
transcripts/

# Codebase-review raw run-logs + agent transcripts (synthesis lives in
# REVIEW_FINDINGS.md + review-fixes/, which ARE committed)
project-harness/review-evidence/

# Logs
*.log

# Generated reports
/reports/

# Local agent tooling + caches (not product code)
.cache/
.claude/

# Docker / env files
*.env
.env.*
!.env.example

# IDE
.vscode/*
!.vscode/settings.json
.idea/

# OS
.DS_Store
Thumbs.db

# Archived review evidence (kept local-only, as the original review-evidence/ was)
project-harness/archive/review-2026-06-03/review-evidence/

# Overnight loop run state (baseline snapshots, locks) - never tracked
project-harness/.loop-state/

# Overnight-run artifact backups (timestamped, recoverable via git history)
evals/generations/*/judged.jsonl.*.bak
evals/generations/*/*.pre-panel-*.bak
evals/generations/*/*.pre-combined-*.bak

# One-shot session prompts and handoffs (DEC-225): keep them out of the repo.
project-harness/PROMPT_*.md
project-harness/*HANDOFF*.md
