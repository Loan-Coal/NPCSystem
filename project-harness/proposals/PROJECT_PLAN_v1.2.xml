      <error>{"success": false, "error": {"code": str, "message": str, "details": object|null}}</error>
      <status_codes>
        <code value="200" meaning="successful read/update" />
        <code value="201" meaning="successful create/upsert (new)" />
        <code value="202" meaning="accepted async maintenance action (optional)" />
        <code value="400" meaning="invalid request shape or route constraints" />
