NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

API_KEY_SECRET=local_dev_secret_change_this_2026
API_KEY_GRAPH_WRITE=
API_KEY_GRAPH_ADMIN=
API_V1_PREFIX=/v1
GAME_SCHEMA_PATH=game_schema.yaml
LLM_CONFIG_PATH=config/llm_config.yaml

IDEMPOTENCY_ENFORCE_HEADER=false
IDEMPOTENCY_HEADER_NAME=X-Idempotency-Key
IDEMPOTENCY_PENDING_TIMEOUT_SECONDS=30
IDEMPOTENCY_RETENTION_HOURS=24
IDEMPOTENCY_CLEANUP_INTERVAL_SECONDS=3600
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=1.0

LLM_BACKEND=mock
LLM_TIMEOUT_SECONDS=10.0
LLM_CACHE_ENABLED=false
LLM_FALLBACK_PATH=data/fallback_responses.json
MISTRAL_API_URL=
LLAMA_API_URL=
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=mixtral:8x7b

EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_BACKEND=memory
QDRANT_URL=
EMBEDDING_REFRESH_ON_WRITE=true
EMBEDDING_RECONCILE_INTERVAL_SECONDS=300
# Context window passed to ollama serve via OLLAMA_CONTEXT_LENGTH env var.
# PROMPT_TOKEN_BUDGET is derived automatically as OLLAMA_CONTEXT_LENGTH - 1200.
# Override PROMPT_TOKEN_BUDGET here only for non-standard splits.
OLLAMA_CONTEXT_LENGTH=4096
# PROMPT_TOKEN_BUDGET=2896
RAG_TOP_K=5

DIALOGUE_SESSION_TURNS=10
DIALOGUE_SESSION_TTL=300
DIALOGUE_STREAM_ENABLED=true

GOSSIP_DISTORTION_BASE=0.3
GOSSIP_DISTORTION_MAX=0.9
GOSSIP_PERSONALITY_FIELDS_ENABLED=true
GOSSIP_TICK_INTERVAL=10

EVENT_POOL_PATH=data/event_pool.json
EVENT_TICK_INTERVAL=20

MAX_RELATION_DELTA_PER_TURN=15
MAX_RELATION_DELTA_PER_WINDOW=40
RELATION_WINDOW_SIZE=10
CURRENCY_MAX_PER_TRANSACTION=1000
CURRENCY_MAX_PER_SESSION=5000

CLOCK_MODE=realtime
MAX_CONCURRENT_TICKS=20
DISTRIBUTED_TICK_LEASE_ENABLED=true
TICK_SCHEDULER_ID=main
TICK_LEASE_OWNER_ID=
TICK_LEASE_TTL_SECONDS=30

LOG_LEVEL=INFO
# Only takes effect when ENV=dev; ignored in staging/prod.
LOG_LLM_PROMPTS=false
ENV=dev
# Optional deterministic seeds for reproducible behavior.
# Leave unset to allow non-deterministic runtime randomness.
# GOSSIP_RNG_SEED=42
# EVENT_RNG_SEED=1337
