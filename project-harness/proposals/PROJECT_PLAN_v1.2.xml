<?xml version="1.0" encoding="UTF-8"?>
<!--
  PROJECT_PLAN_v1.2.xml
  Full specification for NPC Engine v1.2.
  v1.2 extends v1.0 with governed graph-edit APIs and admin operations.
-->
<project name="npc_engine" language="Python" version="3.11" framework="FastAPI" release="v1.2">

  <overview>
    NPC Engine v1.2 preserves all v1.0 runtime behavior (dialogue, gossip, events, scheduler)
    and adds a versioned, production-safe graph editing surface for plugin operators.

    New capability goals:
    1. Resource-specific graph write APIs under /v1/graph/*
    2. Privileged admin operations under /v1/graph/admin/*
    3. Atomic hard-delete with cascade semantics
    4. Relation mutation split:
       - Runtime path: bounded deltas only
       - Admin path: absolute values on dedicated route
    5. Full auditability and testability under existing coding principles
  </overview>

  <release_scope>
    <included>
      <item>Versioned graph-edit routes</item>
      <item>New graph edit schema models</item>
      <item>Graph edit service/orchestrator layer</item>
      <item>Hard-delete cascade service</item>
      <item>Route-level privileged separation (/v1/graph/admin)</item>
      <item>Coverage additions for unit + integration tests</item>
      <item>Docs and tracker updates for v1.2 rollout</item>
    </included>
    <excluded>
      <item>Generic multi-operation batch transaction endpoint (deferred to v1.3)</item>
      <item>Per-user OAuth/identity model</item>
      <item>Cross-instance distributed mutation queue</item>
    </excluded>
  </release_scope>

